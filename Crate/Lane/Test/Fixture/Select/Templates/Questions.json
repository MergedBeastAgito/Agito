{
	"version": 3,
	"templates": {
		"focused": {
			"when": "one reading is enough to answer",
			"questions": {
				"course": {
					"type": "choice",
					"instructions": "Which way should the reading move?",
					"criteria": {
						"closer": "toward the mark",
						"farther": "away from the mark"
					}
				}
			}
		},
		"overview": {
			"when": "the whole observation is read at once",
			"questions": {
				"course": {
					"type": "choice",
					"instructions": "Which way should the reading move?",
					"criteria": {
						"closer": "toward the mark",
						"farther": "away from the mark"
					}
				},
				"disagreement": {
					"type": "score",
					"instructions": "How far is the reading from the mark?",
					"criteria": ["none", "slight", "clear"]
				}
			}
		}
	},
	"lanes": {
		"steady": {
			"fields": ["speed", "yaw"],
			"templates": ["focused"],
			"select": {
				"op": "lt",
				"field": "yaw",
				"than": 5
			},
			"cadence": "every tick",
			"why": "nothing is turning, so one reading answers"
		},
		"turning": {
			"fields": ["speed", "yaw"],
			"templates": ["focused"],
			"select": {
				"op": "and",
				"of": [
					{
						"op": "gt",
						"field": "yaw",
						"than": 5
					},
					{
						"op": "lt",
						"field": "speed",
						"than": 120
					}
				]
			},
			"cadence": "on approach to a turn",
			"why": "yaw says how the reading is actually rotating"
		},
		"fast": {
			"fields": ["speed", "yaw"],
			"templates": ["overview"],
			"select": {
				"op": "and",
				"of": [
					{
						"op": "gt",
						"field": "speed",
						"than": 120
					},
					{
						"op": "gt",
						"field": "yaw",
						"than": 5
					}
				]
			},
			"cadence": "rarely - a slow lane for judgement",
			"why": "at speed the whole reading is worth weighing"
		},
		"blocked": {
			"fields": ["speed", "surface", "blocked_ticks"],
			"templates": ["overview"],
			"select": {
				"op": "and",
				"of": [
					{
						"op": "lt",
						"field": "speed",
						"than": 1
					},
					{
						"op": "gt",
						"field": "blocked_ticks",
						"than": 3
					}
				]
			},
			"cadence": "only while blocked",
			"why": "the metres not moved are the evidence that something is against it"
		}
	}
}
