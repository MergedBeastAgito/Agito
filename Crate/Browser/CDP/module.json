{
	"Name": "@agito/browser-cdp",
	"Kind": "Adapter",
	"Version": "0.1.3",
	"Provide": {
		"Port": "agito.browse",
		"Error": ["browser-unavailable", "navigation-failed", "timeout"]
	},
	"Require": {
		"Endpoint": "env:CDP_URL"
	},
	"Artefact": {
		"Entry": "Target/debug/libCDP.rlib",
		"Hash": null,
		"RunTime": "rust>=1.88"
	},
	"State": "HoldTransport",
	"Cost": {
		"ColdMs": 900,
		"WarmMs": 5,
		"Network": true,
		"Process": ["chromium"]
	},
	"Verify": "agito verify --module @agito/browser-cdp"
}
