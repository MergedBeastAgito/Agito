{
	"name": "@agentic/chat-driver",
	"kind": "capability",
	"version": "0.1.3",
	"provides": {
		"port": "agentic.chat.ask",
		"errors": ["not-ready", "wrong-mode", "wrong-model", "truncated"],
		"verbs": {
			"agentic.chat.note": { "errors": [] }
		}
	},
	"requires": {
		"ports": ["agentic.browse"]
	},
	"artefact": {
		"entry": "Target/debug/libAgenticChatDriver.rlib",
		"hash": null,
		"runtime": "rust>=1.88"
	},
	"state": "holds-transport",
	"cost": {
		"coldMs": 20,
		"warmMs": 2,
		"network": true
	},
	"verify": "agentic verify --module @agentic/chat-driver"
}
