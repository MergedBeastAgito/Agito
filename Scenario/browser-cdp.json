{
	"$comment": "The scenarios for `agentic.browse`, and the only statement of the contract the browser adapter is held to. `Crate/BrowserCDP/Test/Parity.rs` reads this file and `generated/browser-cdp.timing.json`, drives the port through a scripted launcher and transport, and asserts each case's `expect` block: the result, the ordered effect list and the number of reports. `effects` is the protocol the implementation spoke - every launch, attach, evaluation and release the fake observed, in order - so a port that returns the right value by the wrong route fails. A case's `rust` names the unit case in `Crate/BrowserCDP/Test/Browse.rs` that proves it, and `Parity.rs` refuses a case that names a test which does not exist. `Documentation/Parity.md` says what this file establishes and what it does not.",
	"capability": "agentic.browse",
	"version": 1,
	"fixture": {
		"endpoint": "ws://127.0.0.1:9222/devtools/page/1",
		"transport": {
			"behaviour": "answer",
			"answer": null,
			"closed": false,
			"closeFailure": null,
			"hangOnClose": false
		},
		"launcher": {
			"open": "answer",
			"failure": null,
			"deadOnArrival": false
		},
		"session": {
			"disposeTimeoutMs": 40,
			"report": "record"
		}
	},
	"cases": [
		{
			"id": "open-launches",
			"rust": "launches_a_browser_when_the_caller_names_no_endpoint",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "target",
					"ownership": "launched",
					"url": "https://example.test/",
					"ws": "ws://127.0.0.1:9222/devtools/page/1"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "open-attaches",
			"rust": "attaches_to_a_browser_the_caller_already_owns",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"attachTo": "http://127.0.0.1:9222"
				}
			],
			"expect": {
				"result": {
					"kind": "target",
					"ownership": "attached",
					"url": "https://example.test/",
					"ws": "ws://127.0.0.1:9222/devtools/page/1"
				},
				"effects": [
					"attach:http://127.0.0.1:9222",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "open-navigation",
			"rust": "fails_with_navigation_failed_when_the_page_does_not_load",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"open": "throw",
							"failure": {
								"code": "navigation",
								"message": "the page did not load",
								"detail": "net::ERR_NAME_NOT_RESOLVED"
							}
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "navigation-failed",
					"message": "the page did not load"
				},
				"effects": ["launch:https://example.test/"],
				"reports": 0
			}
		},
		{
			"id": "open-unavailable",
			"rust": "fails_with_browser_unavailable_when_the_browser_cannot_be_reached",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"open": "throw",
							"failure": {
								"code": "unavailable",
								"message": "connect ECONNREFUSED 127.0.0.1:9222",
								"detail": "the socket was refused"
							}
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"observed": "ECONNREFUSED"
				},
				"note": "The observation is asserted somewhere in the failure - message or detail - rather than in a named field: which of the two carries the reason is the port's choice, and the promise is that the reason is not lost.",
				"effects": ["launch:https://example.test/"],
				"reports": 0
			}
		},
		{
			"id": "open-dead-on-arrival",
			"rust": "releases_a_transport_that_arrives_already_dead",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"deadOnArrival": true
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "already closed"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-answers",
			"rust": "returns_the_value_the_page_produced",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"answer": 42
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "1 + 41",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "value",
					"value": 42
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:1 + 41"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-aborted-before",
			"rust": "fails_with_timeout_before_asking_when_the_signal_is_already_aborted",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 5000,
					"signal": "aborted"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "timeout",
					"message": "cancelled before it started"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-no-signal",
			"rust": "still_honours_the_deadline_with_a_cancellation_that_never_fires",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"behaviour": "hang"
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 20,
					"signal": "absent"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "timeout",
					"message": "deadline"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:document.title"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-known-closed",
			"rust": "never_asks_a_transport_it_already_knows_is_closed",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"closed": true
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "closed"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-page-throws",
			"rust": "fails_with_navigation_failed_when_the_page_throws",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"behaviour": "throw"
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "nope.nope",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "navigation-failed",
					"message": "could not answer"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:nope.nope"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-foreign-target",
			"rust": "fails_with_browser_unavailable_on_a_target_this_session_does_not_hold",
			"steps": [
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"target": {
						"url": "https://example.test/",
						"ws": "ws://127.0.0.1:9222/devtools/page/9",
						"ownership": "attached"
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "holds no transport"
				},
				"effects": [],
				"reports": 0
			}
		},
		{
			"id": "dispose-launched",
			"rust": "closes_a_launched_target",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-attached",
			"rust": "detaches_an_attached_target_without_closing_it",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"attachTo": "http://127.0.0.1:9222"
				},
				{
					"op": "dispose",
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"attach:http://127.0.0.1:9222",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"detach:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-twice",
			"rust": "is_silent_when_called_twice",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"times": 2
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-failing-release",
			"rust": null,
			"skip": ["rust"],
			"unported": "`Transport::Close` returns `()`, so a release cannot fail and there is no cause to report. A release that hangs is reportable (see `generated/dispose-hang`); a release that rejects is not expressible in the port at all, because there is no error for it to return. The case stays as the record of a shape the port cannot have, and the scenario run skips it.",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"before": {
						"transport": {
							"closeFailure": "the browser refused to close"
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1",
					"close-failed:ws://127.0.0.1:9222/devtools/page/1",
					"report:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 1
			}
		},
		{
			"id": "dispose-reporter-throws",
			"rust": "does_not_fail_when_its_own_reporter_panics",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"before": {
						"transport": {
							"hangOnClose": true
						},
						"session": {
							"report": "throw",
							"disposeTimeoutMs": 20
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1",
					"report:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 1
			}
		},
		{
			"id": "dispose-foreign-target",
			"rust": "resolves_for_a_target_this_session_never_opened",
			"steps": [
				{
					"op": "dispose",
					"target": {
						"url": "https://example.test/",
						"ws": "ws://127.0.0.1:9222/devtools/page/9",
						"ownership": "launched"
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [],
				"reports": 0
			}
		},
		{
			"id": "dispose-then-evaluate",
			"rust": "leaves_the_target_unusable_afterwards",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last"
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "holds no transport"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		}
	]
}
