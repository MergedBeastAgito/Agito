{
	"name": "@agentic/workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Capabilities, adapters and the runtime that leases them.",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"Format": "npm run Format:Prettier && npm run Format:Rust",
		"Format:Prettier": "prettier --write .",
		"Format:Rust": "cargo fmt --all",
		"Format:Check": "prettier --check . && cargo fmt --all -- --check",
		"Test": "cargo test --workspace"
	},
	"devDependencies": {
		"prettier": "3.9.10"
	},
	"engines": {
		"node": ">=22.23.4"
	}
}
