{
	"name": "@agentic/chat-driver",
	"kind": "capability",
	"version": "0.1.0",
	"provides": {
		"port": "agentic.chat.ask",
		"errors": ["not-ready", "wrong-mode", "wrong-model", "truncated"]
	},
	"requires": {
		"ports": ["agentic.browse"]
	},
	"artefact": {
