{
	"name": "@agentic/browser-cdp",
	"kind": "adapter",
	"version": "0.1.0",
	"provides": {
		"port": "agentic.browse",
		"errors": ["browser-unavailable", "navigation-failed", "timeout"]
	},
	"requires": {
		"endpoint": "env:CDP_URL"
	},
	"artefact": {
		"entry": "Target/index.js",
		"hash": null,
		"runtime": "node>=22.23.4"
	},
	"state": "holds-transport",
	"cost": {
		"coldMs": 900,
		"warmMs": 5,
		"network": true,
		"processes": ["chromium"]
	},
	"verify": "node --test Test/*.test.ts"
}
