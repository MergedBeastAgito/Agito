flowchart TD
  FREE["Free"]:::store
  HELD["Held<br>fence n"]:::store
  EXPIRED["Expired<br>the module's clock passed expiry"]:::store
  REFUSED["Refused<br>another holder"]:::fail
  FREE ==>|"claim(resource, ttl)"| HELD
