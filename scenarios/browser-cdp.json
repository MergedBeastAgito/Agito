{
	"$comment": "The differential scenarios for `agentic.browse`. One file, read by both implementations: `scenarios/ts.mjs` drives `packages/browser-cdp`, `rust/Crate/BrowserCDP/tests/parity.rs` drives the Rust port, and both answer the same `expect` block. `effects` is the ordered list of what the fake launcher and transport observed - the protocol the implementation spoke - so an implementation that returns the right value by the wrong route fails. See `docs/Parity.md` for the case map.",
	"capability": "agentic.browse",
	"version": 1,
	"fixture": {
		"endpoint": "ws://127.0.0.1:9222/devtools/page/1",
		"transport": {
			"behaviour": "answer",
			"answer": null,
			"closed": false,
			"closeFailure": null,
			"hangOnClose": false
		},
		"launcher": {
			"open": "answer",
			"failure": null,
			"deadOnArrival": false
		},
		"session": {
			"disposeTimeoutMs": 40,
			"report": "record"
		}
	},
	"cases": [
		{
			"id": "open-launches",
			"typescript": "launches a browser when the caller names no endpoint",
			"rust": "launches_a_browser_when_the_caller_names_no_endpoint",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "target",
					"ownership": "launched",
					"url": "https://example.test/",
					"ws": "ws://127.0.0.1:9222/devtools/page/1"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "open-attaches",
			"typescript": "attaches to a browser the caller already owns",
			"rust": "attaches_to_a_browser_the_caller_already_owns",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"attachTo": "http://127.0.0.1:9222"
				}
			],
			"expect": {
				"result": {
					"kind": "target",
					"ownership": "attached",
					"url": "https://example.test/",
					"ws": "ws://127.0.0.1:9222/devtools/page/1"
				},
				"effects": [
					"attach:http://127.0.0.1:9222",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "open-navigation",
			"typescript": "rejects with navigation-failed when the page does not load",
			"rust": "fails_with_navigation_failed_when_the_page_does_not_load",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"open": "throw",
							"failure": {
								"code": "navigation",
								"message": "the page did not load",
								"detail": "net::ERR_NAME_NOT_RESOLVED"
							}
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "navigation-failed",
					"message": "the page did not load"
				},
				"effects": ["launch:https://example.test/"],
				"reports": 0
			}
		},
		{
			"id": "open-unavailable",
			"typescript": "rejects with browser-unavailable when the browser cannot be reached",
			"rust": "fails_with_browser_unavailable_when_the_browser_cannot_be_reached",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"open": "throw",
							"failure": {
								"code": "unavailable",
								"message": "connect ECONNREFUSED 127.0.0.1:9222",
								"detail": "the socket was refused"
							}
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"observed": "ECONNREFUSED"
				},
				"note": "The two ports keep the observation in different fields: TypeScript writes its own sentence and puts the reason in `detail`, Rust's launcher already speaks the port's error so the reason is its message. The scenario asserts the observation survives, not where.",
				"effects": ["launch:https://example.test/"],
				"reports": 0
			}
		},
		{
			"id": "open-dead-on-arrival",
			"typescript": "releases a transport that arrives already dead",
			"rust": "releases_a_transport_that_arrives_already_dead",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"launcher": {
							"deadOnArrival": true
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "already closed"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-answers",
			"typescript": "returns the value the page produced",
			"rust": "returns_the_value_the_page_produced",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"answer": 42
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "1 + 41",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "value",
					"value": 42
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:1 + 41"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-aborted-before",
			"typescript": "rejects with timeout before asking when the signal is already aborted",
			"rust": "fails_with_timeout_before_asking_when_the_signal_is_already_aborted",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 5000,
					"signal": "aborted"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "timeout",
					"message": "cancelled before it started"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-no-signal",
			"typescript": "still honours the deadline when the caller passes no signal",
			"rust": "still_honours_the_deadline_with_a_cancellation_that_never_fires",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"behaviour": "hang"
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 20,
					"signal": "absent"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "timeout",
					"message": "deadline"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:document.title"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-known-closed",
			"typescript": "never asks a transport it already knows is closed",
			"rust": "never_asks_a_transport_it_already_knows_is_closed",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"closed": true
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "closed"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-page-throws",
			"typescript": "rejects with navigation-failed when the page throws",
			"rust": "fails_with_navigation_failed_when_the_page_throws",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"before": {
						"transport": {
							"behaviour": "throw"
						}
					}
				},
				{
					"op": "evaluate",
					"expression": "nope.nope",
					"timeoutMs": 40
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "navigation-failed",
					"message": "could not answer"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"evaluate:nope.nope"
				],
				"reports": 0
			}
		},
		{
			"id": "evaluate-foreign-target",
			"typescript": "rejects with browser-unavailable on a target this session does not hold",
			"rust": "fails_with_browser_unavailable_on_a_target_this_session_does_not_hold",
			"steps": [
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"target": {
						"url": "https://example.test/",
						"ws": "ws://127.0.0.1:9222/devtools/page/9",
						"ownership": "attached"
					}
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "holds no transport"
				},
				"effects": [],
				"reports": 0
			}
		},
		{
			"id": "dispose-launched",
			"typescript": "closes a launched target",
			"rust": "closes_a_launched_target",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-attached",
			"typescript": "detaches an attached target without closing it",
			"rust": "detaches_an_attached_target_without_closing_it",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40,
					"attachTo": "http://127.0.0.1:9222"
				},
				{
					"op": "dispose",
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"attach:http://127.0.0.1:9222",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"detach:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-twice",
			"typescript": "is silent when called twice",
			"rust": "is_silent_when_called_twice",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"times": 2
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		},
		{
			"id": "dispose-failing-release",
			"typescript": "reports a failing release instead of throwing it",
			"rust": null,
			"skip": ["rust"],
			"unported": "The Rust `Transport::Close` returns `()`, so a release cannot fail and there is no cause to report. A release that hangs is reportable (see `generated/dispose-hang`), a release that rejects is not expressible in the port at all: the TypeScript port can report an arbitrary cause, the Rust one only ever reports `timeout`.",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"before": {
						"transport": {
							"closeFailure": "the browser refused to close"
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1",
					"close-failed:ws://127.0.0.1:9222/devtools/page/1",
					"report:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 1
			}
		},
		{
			"id": "dispose-reporter-throws",
			"typescript": "does not throw when its own reporter throws",
			"rust": "does_not_fail_when_its_own_reporter_panics",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last",
					"before": {
						"transport": {
							"hangOnClose": true
						},
						"session": {
							"report": "throw",
							"disposeTimeoutMs": 20
						}
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1",
					"report:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 1
			}
		},
		{
			"id": "dispose-foreign-target",
			"typescript": "resolves for a target this session never opened",
			"rust": "resolves_for_a_target_this_session_never_opened",
			"steps": [
				{
					"op": "dispose",
					"target": {
						"url": "https://example.test/",
						"ws": "ws://127.0.0.1:9222/devtools/page/9",
						"ownership": "launched"
					}
				}
			],
			"expect": {
				"result": {
					"kind": "void"
				},
				"effects": [],
				"reports": 0
			}
		},
		{
			"id": "dispose-then-evaluate",
			"typescript": "leaves the target unusable afterwards",
			"rust": "leaves_the_target_unusable_afterwards",
			"steps": [
				{
					"op": "open",
					"url": "https://example.test/",
					"timeoutMs": 40
				},
				{
					"op": "dispose",
					"target": "last"
				},
				{
					"op": "evaluate",
					"expression": "document.title",
					"timeoutMs": 40,
					"target": "last"
				}
			],
			"expect": {
				"result": {
					"kind": "error",
					"code": "browser-unavailable",
					"message": "holds no transport"
				},
				"effects": [
					"launch:https://example.test/",
					"handed:ws://127.0.0.1:9222/devtools/page/1",
					"close:ws://127.0.0.1:9222/devtools/page/1"
				],
				"reports": 0
			}
		}
	]
}
