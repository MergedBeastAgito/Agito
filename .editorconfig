root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,jsx,css}]
indent_style = tab
indent_size = 4

# The Rust tree is tab-indented, and now the tool agrees: `rustfmt.toml` sets
# `hard_tabs = true`, adopted from the sibling Aphrodite tree. The editor entry
# below is here so a file opened before rustfmt runs already looks like its
# neighbours.
[*.rs]
indent_style = tab
indent_size = 4
